# Waylo agent backend — copy to .env and fill in.
# This backend runs on Gemini via GenKit.

AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com/app/apikey
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash

# PostgreSQL (Aurora / Cloud SQL) connection string, with pgvector.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Server port (Cloud Run sets this automatically in production).
PORT=3000

# Optional:
# ALLOWED_ORIGINS=https://example.com,https://another.com
# YOLO_SERVICE_URL=http://your-vision-service:8000
